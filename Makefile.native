# EmbedXPL-Forge - Native Payload Build System
# Compiles C/ASM exploits for embedded Linux targets (ARM, MIPS, x86)
#
# Usage:
#   make all          # build all native payloads
#   make arm          # ARM targets (cameras, routers)
#   make mips         # MIPS targets (routers, IoT)
#   make x86          # x86/x64 (kernel LPE, servers)
#   make clean
#
# Requirements:
#   arm-linux-gnueabi-gcc  (apt: gcc-arm-linux-gnueabi)
#   mipsel-linux-gnu-gcc   (apt: gcc-mipsel-linux-gnu)
#   gcc (native)

.PHONY: all arm mips x86 clean dirs help

OUTDIR  := embedxpl/resources/payloads
NDIR    := embedxpl/modules/exploits/embedded_os/linux_kernel/_native
RES_NDIR := resources/native_src/c/routers/tenda

# ARM cross-compiler
ARM_CC   := arm-linux-gnueabi-gcc
ARM_CXX  := arm-linux-gnueabi-g++
ARM_FLAGS := -O2 -static -Wall -Wextra -fno-stack-protector -z execstack

# MIPS little-endian cross-compiler  
MIPSEL_CC := mipsel-linux-gnu-gcc
MIPSEL_FLAGS := -O2 -static -Wall -fno-stack-protector -z execstack

# Native x86_64
CC    := gcc
FLAGS := -O2 -Wall -Wextra -lpthread

all: dirs arm mips x86
	@echo "[+] All native payloads built in $(OUTDIR)/"

dirs:
	@mkdir -p $(OUTDIR)/arm $(OUTDIR)/mips $(OUTDIR)/x86

# ============================================================
# ARM Payloads (cameras, IoT routers, ARM-based devices)
# ============================================================
arm: dirs
	@echo "[*] Building ARM payloads..."
	@if command -v $(ARM_CC) >/dev/null 2>&1; then \
		$(ARM_CC) $(ARM_FLAGS) \
			-DTARGET_ARCH=\"arm\" \
			-o $(OUTDIR)/arm/dirtyclone_arm \
			$(NDIR)/dirtyclone/dirtyclone.c \
			&& echo "[+] dirtyclone (ARM) built" || echo "[-] dirtyclone arm failed"; \
		$(ARM_CC) $(ARM_FLAGS) \
			-o $(OUTDIR)/arm/dirtyfrag_arm \
			$(NDIR)/dirtyfrag/exp.c \
			&& echo "[+] dirtyfrag (ARM) built" || echo "[-] dirtyfrag arm failed"; \
		$(ARM_CC) $(ARM_FLAGS) \
			-o $(OUTDIR)/arm/tenda_bof_arm \
			$(RES_NDIR)/tenda_fh451_bof_cve_2025_7795.c \
			&& echo "[+] tenda_fh451_bof (ARM) built" || echo "[-] tenda bof arm failed"; \
	else \
		echo "[-] $(ARM_CC) not found. Install: sudo apt install gcc-arm-linux-gnueabi"; \
	fi

# ============================================================
# MIPS Payloads (D-Link, ASUS, Tenda MIPS-based routers)
# ============================================================
mips: dirs
	@echo "[*] Building MIPS (little-endian) payloads..."
	@if command -v $(MIPSEL_CC) >/dev/null 2>&1; then \
		$(MIPSEL_CC) $(MIPSEL_FLAGS) \
			-o $(OUTDIR)/mips/dirtyclone_mipsel \
			$(NDIR)/dirtyclone/dirtyclone.c \
			&& echo "[+] dirtyclone (MIPSEL) built" || echo "[-] dirtyclone mipsel failed"; \
	else \
		echo "[-] $(MIPSEL_CC) not found. Install: sudo apt install gcc-mipsel-linux-gnu"; \
	fi

# ============================================================
# x86/x86_64 Payloads (kernel LPE, servers)
# ============================================================
x86: dirs
	@echo "[*] Building x86_64 payloads..."
	$(CC) $(FLAGS) \
		-o $(OUTDIR)/x86/dirtyclone_x64 \
		$(NDIR)/dirtyclone/dirtyclone.c \
		&& echo "[+] dirtyclone (x64) built" || echo "[-] dirtyclone x64 failed"
	$(CC) $(FLAGS) \
		-o $(OUTDIR)/x86/dirtyfrag_x64 \
		$(NDIR)/dirtyfrag/exp.c \
		&& echo "[+] dirtyfrag (x64) built" || echo "[-] dirtyfrag x64 failed"
	$(CC) $(FLAGS) \
		-o $(OUTDIR)/x86/peditcow_x64 \
		$(NDIR)/peditcow/pedit_primitive.c \
		$(NDIR)/peditcow/packet_edit_meme.c \
		&& echo "[+] peditcow (x64) built" || echo "[-] peditcow x64 failed"

clean:
	rm -rf $(OUTDIR)/arm/ $(OUTDIR)/mips/ $(OUTDIR)/x86/

check-deps:
	@echo "Checking cross-compiler dependencies..."
	@command -v $(ARM_CC) && echo "[+] ARM CC: OK" || echo "[-] ARM CC missing: sudo apt install gcc-arm-linux-gnueabi"
	@command -v $(MIPSEL_CC) && echo "[+] MIPSEL CC: OK" || echo "[-] MIPSEL CC missing: sudo apt install gcc-mipsel-linux-gnu"
	@command -v $(CC) && echo "[+] Native CC: OK"

help:
	@echo "EmbedXPL Native Payload Builder"
	@echo ""
	@echo "Targets:"
	@echo "  all        - Build all architectures"
	@echo "  arm        - ARM (cameras, IoT routers)"
	@echo "  mips       - MIPS LE (D-Link, ASUS, Tenda)"
	@echo "  x86        - x86_64 (kernel LPE, servers)"
	@echo "  clean      - Remove built payloads"
	@echo "  check-deps - Check compiler availability"
	@echo ""
	@echo "Output: embedxpl/resources/payloads/{arm,mips,x86}/"
